{
  "name": "light-code-vscode",
  "displayName": "Light Code",
  "description": "A minimal agentic coding assistant. Bring your own model. No telemetry, no default endpoints.",
  "private": true,
  "version": "0.8.0",
  "publisher": "ChosenGeneration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chosengenerationdev/light-code.git"
  },
  "bugs": {
    "url": "https://github.com/chosengenerationdev/light-code/issues"
  },
  "homepage": "https://github.com/chosengenerationdev/light-code#readme",
  "qna": "https://github.com/chosengenerationdev/light-code/issues",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "chatgpt",
    "claude",
    "copilot",
    "gemini",
    "llm",
    "mcp",
    "openai",
    "assistant"
  ],
  "icon": "resources/icon-256.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lightCode.openPanel",
        "title": "Light Code: Open Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lightCode",
          "title": "Light Code",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "lightCode": [
        {
          "type": "webview",
          "id": "lightCode.chatView",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.84.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@light-code/core": "workspace:*",
    "@light-code/ui": "workspace:*",
    "@vscode/ripgrep": "^1.18.0"
  }
}
